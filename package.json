{
  "name": "phabricator-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern, local-first successor to Phabricator for code and research.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnclyde/phabricator-next.git"
  },
  "homepage": "https://github.com/johnclyde/phabricator-next#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts server/*.test.ts",
    "check": "tsc --noEmit",
    "arc": "tsx cli/index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "diff": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
