{
  "name": "phabricator-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern, local-first successor to Phabricator for code and research.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnclyde/phabricator-next.git"
  },
  "homepage": "https://github.com/johnclyde/phabricator-next#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts server/*.test.ts",
    "check": "tsc --noEmit",
    "arc": "tsx cli/index.ts",
    "accounts": "node --env-file-if-exists=.env --import tsx scripts/accounts.ts",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "transcription:model": "node --import tsx scripts/prepare-transcription-model.ts",
    "git:receive": "node --import tsx scripts/git-receive-hook.ts",
    "drydock:worker": "node --import tsx scripts/drydock-worker.ts"
  },
  "dependencies": {
    "diff": "^8.0.0",
    "highlight.js": "11.12.0",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "saxes": "6.0.0",
    "tsx": "^4.19.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "firebase": "12.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.6"
  }
}
