# Server configuration. Use shell environment variables or Node's --env-file flag.
PORT=4310
# Use the same path for npm run build and npm start (for example /workspace/).
APP_BASE_PATH=/
# Password mode requires an account provisioned with npm run accounts first.
# Both modes accept loopback connections only. For a same-host HTTPS proxy,
# set a canonical public origin and use password mode; see docs/hosting.md.
# APP_PUBLIC_ORIGIN=https://reviews.example.com
APP_AUTH_MODE=local
# Optional Google sign-in for hosted password mode; provider configuration and
# explicit Firebase UID-to-workspace-account mappings belong in the private env.
# See docs/google-sign-in.md. Omit APP_GOOGLE_AUTH to keep it disabled.
# Optional outbound notification email; personal and per-object opt-in are also
# required. Omit these settings to keep mail disabled. See docs/notification-email.md.
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=465
# APP_SMTP_SECURE=true
# APP_MAIL_FROM=notifications@example.com
# APP_MAIL_RECIPIENTS='{"CURRENT_ACCOUNT_ID":"person@example.com"}'
# Store APP_SMTP_USERNAME and APP_SMTP_PASSWORD in the operator's secret store.
DATABASE_PATH=.data/phabricator.sqlite
SEED_DEMO=true
# Revision lifecycle configuration. Values must be exactly true or false.
# The current author normally closes accepted revisions or abandons open ones.
# Enabling these options still requires current source view/edit authority.
REVISION_ALLOW_REOPEN=false
REVISION_ALWAYS_ALLOW_CLOSE=false
REVISION_ALWAYS_ALLOW_ABANDON=false
# Treat accepted revisions as closed without claiming they have been landed.
REVISION_CLOSE_ON_ACCEPT=false
# Optional operator-owned bare Git repositories, keyed by registered repository ID.
# APP_GIT_REPOSITORIES='{"R1":"/srv/git/example.git"}'
# Optional explicit squash-landing destinations; see docs/revision-landing.md.
# APP_LANDING_BINDINGS='[{"key":"example-main","repositoryId":"R1","repositoryPath":"/srv/git/example.git","branches":["refs/heads/main"]}]'

# Optional explicit paper compilation. Set both only after preparing the pinned
# isolated image described in docs/tex-worker.md. Never executes TeX on the host.
# PHABRICATOR_TEX_IMAGE=sha256:YOUR_PREPARED_IMAGE_DIGEST
# PHABRICATOR_TEX_DOCKER_SOCKET=/var/run/docker.sock
# PHABRICATOR_TEX_WORK_DIR=.data/tex-worker

# Optional browser-local speech transcription. Explicitly stage the pinned
# public model first: npm run transcription:model -- --directory .data/speech-model
# Users separately choose Install model and Transcribe on this device in Audio.
# APP_TRANSCRIPTION_MODEL_DIR=.data/speech-model

# Optional explicit hosted review. Never exposed to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local review through an already installed Ollama model.
# Run Ollama with cloud functionality disabled for offline/private operation.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Permit a revision author to record their own acceptance (default false).
# This does not bypass current interaction or source access requirements.
REVISION_ALLOW_SELF_ACCEPT=false

# Require a nonempty test plan for new revisions and revision-details edits.
# This describes planned verification; it does not run tests or grant acceptance.
REVISION_REQUIRE_TEST_PLAN=true

# Authenticated account IDs allowed to edit workspace task statuses, fields and forms.
# Local single-user mode can configure tasks without this setting.
# APP_MANIPHEST_ADMIN_PRINCIPAL_IDS=["account-id"]

# Optional authority, scheduled upstream fetch and outbound mirrors. Paths must be writable.
# See docs/repository-operations.md for credentials, safeguards and primary-host cutover.
# APP_REPOSITORY_OPERATIONS='[{"repositoryId":"R1","path":"/srv/git/example.git","mode":"observe","observe":{"url":"https://github.com/example/project.git"},"intervalSeconds":300}]'
