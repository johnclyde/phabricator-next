# Server configuration. Use shell environment variables or Node's --env-file flag.
PORT=4310
# Use the same path for npm run build and npm start (for example /workspace/).
APP_BASE_PATH=/
# Password mode requires an account provisioned with npm run accounts first.
# Both modes currently accept loopback connections only.
APP_AUTH_MODE=local
DATABASE_PATH=.data/phabricator.sqlite
SEED_DEMO=true
# Revision lifecycle configuration. Values must be exactly true or false.
# The current author normally closes accepted revisions or abandons open ones.
# Enabling these options still requires current source view/edit authority.
REVISION_ALLOW_REOPEN=false
REVISION_ALWAYS_ALLOW_CLOSE=false
REVISION_ALWAYS_ALLOW_ABANDON=false
# Treat accepted revisions as closed without claiming they have been landed.
REVISION_CLOSE_ON_ACCEPT=false
# Optional operator-owned bare Git repositories, keyed by registered repository ID.
# APP_GIT_REPOSITORIES='{"R1":"/srv/git/example.git"}'

# Optional explicit paper compilation. Set both only after preparing the pinned
# isolated image described in docs/tex-worker.md. Never executes TeX on the host.
# PHABRICATOR_TEX_IMAGE=sha256:YOUR_PREPARED_IMAGE_DIGEST
# PHABRICATOR_TEX_DOCKER_SOCKET=/var/run/docker.sock
# PHABRICATOR_TEX_WORK_DIR=.data/tex-worker

# Optional explicit hosted review. Never exposed to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local review through an already installed Ollama model.
# Run Ollama with cloud functionality disabled for offline/private operation.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
